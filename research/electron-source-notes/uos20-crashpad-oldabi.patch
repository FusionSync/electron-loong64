   } t64;
+
+#if defined(ARCH_CPU_LOONGARCH64)
+  static_assert(offsetof(t64_t, csr_era) == offsetof(user_pt_regs, csr_era),
+                "UOS ptrace PC offset mismatch");
+  static_assert(offsetof(t64_t, csr_badv) == offsetof(user_pt_regs, csr_badv),
+                "UOS ptrace fault-address offset mismatch");
+#endif
 
 #if defined(ARCH_CPU_X86_FAMILY) || defined(ARCH_CPU_ARM64) || \
     defined(ARCH_CPU_RISCV64) || defined(ARCH_CPU_LOONGARCH_FAMILY)
@@ -283,7 +290,7 @@
     uint64_t fpregs[32];
     uint64_t fcsr;
 #elif defined(ARCH_CPU_LOONGARCH_FAMILY)
-    // Reflects user_fp_struct in sys/user.h
+    // Reflects UOS user_fp_state in asm/ptrace.h
     uint64_t fpregs[32];
     uint64_t fcc;
     uint32_t fcsr;
@@ -319,7 +326,11 @@
 #elif defined(ARCH_CPU_RISCV64)
   static_assert(sizeof(f64) == sizeof(__riscv_d_ext_state), "Size mismatch");
 #elif defined(ARCH_CPU_LOONGARCH_FAMILY)
-  static_assert(sizeof(f64) == sizeof(user_fp_struct), "Size mismatch");
+  static_assert(sizeof(f64) == sizeof(user_fp_state), "Size mismatch");
+  static_assert(offsetof(f64_t, fcc) == offsetof(user_fp_state, fcc),
+                "UOS ptrace FCC offset mismatch");
+  static_assert(offsetof(f64_t, fcsr) == offsetof(user_fp_state, fcsr),
+                "UOS ptrace FCSR offset mismatch");
