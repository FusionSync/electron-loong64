#!/usr/bin/env bash
# Source this file inside the x86_64 build container.
attempt_root=/work/electron37-attempt
# The base image's convenience variables force GCC8/LoongArch globally.
# Chromium must select its x86 host and LoongArch target tools independently.
unset CC CXX AR RANLIB STRIP PKG_CONFIG
export PATH="$attempt_root/host-runtime/bin:$attempt_root/src/buildtools/linux64:$attempt_root/src/third_party/ninja:$attempt_root/tools/depot_tools:$attempt_root/tools/rust188/bin:$PATH"
if [[ -n "${UOS_BUILD_PROXY:-}" ]]; then
  export http_proxy="$UOS_BUILD_PROXY"
  export https_proxy="$UOS_BUILD_PROXY"
  export HTTP_PROXY="$UOS_BUILD_PROXY"
  export HTTPS_PROXY="$UOS_BUILD_PROXY"
else
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
fi
# This registry's TLS handshake fails through the build proxy; HTTPS works
# directly, including Yarn's pinned tarball URLs and integrity checks.
export no_proxy=localhost,127.0.0.1,registry.yarnpkg.com
export NO_PROXY="$no_proxy"
# Native https.get in dependency postinstall scripts (for example dugite)
# needs Node's opt-in proxy handling; this also honors NO_PROXY above.
export NODE_USE_ENV_PROXY=1
export DEPOT_TOOLS_UPDATE=0
export DEPOT_TOOLS_METRICS=0
export RUSTC_BOOTSTRAP=1
export CHROMIUM_BUILDTOOLS_PATH="$attempt_root/src/buildtools"
export UOS_NODE_BINARY="$attempt_root/host-runtime/bin/node"
export UOS_NINJA_JOBS="${UOS_NINJA_JOBS:-8}"

