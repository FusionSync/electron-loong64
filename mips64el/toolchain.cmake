set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mips64el)
set(MIPS64EL_TRIPLE mips64el-linux-gnuabi64)
set(MIPS64EL_SYSROOT $ENV{MIPS64EL_SYSROOT})
set(CMAKE_SYSROOT ${MIPS64EL_SYSROOT})
set(CMAKE_C_COMPILER ${MIPS64EL_TRIPLE}-gcc)
set(CMAKE_CXX_COMPILER ${MIPS64EL_TRIPLE}-g++)
set(CMAKE_ASM_COMPILER ${MIPS64EL_TRIPLE}-as)
set(CMAKE_AR ${MIPS64EL_TRIPLE}-ar)
set(CMAKE_RANLIB ${MIPS64EL_TRIPLE}-ranlib)
set(CMAKE_STRIP ${MIPS64EL_TRIPLE}-strip)
set(CMAKE_C_COMPILER_TARGET ${MIPS64EL_TRIPLE})
set(CMAKE_CXX_COMPILER_TARGET ${MIPS64EL_TRIPLE})
set(CMAKE_C_FLAGS_INIT "-march=mips64r2 -mabi=64")
set(CMAKE_CXX_FLAGS_INIT "-march=mips64r2 -mabi=64")
set(CMAKE_FIND_ROOT_PATH ${MIPS64EL_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
