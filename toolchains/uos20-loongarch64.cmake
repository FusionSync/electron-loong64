set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR loongarch64)
set(CMAKE_C_COMPILER /usr/local/bin/uos-cc)
set(CMAKE_CXX_COMPILER /usr/local/bin/uos-c++)
set(CMAKE_SYSROOT /opt/uos-sysroot)
set(CMAKE_FIND_ROOT_PATH /opt/uos-sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(PKG_CONFIG_EXECUTABLE /usr/local/bin/uos-pkg-config CACHE FILEPATH "Target pkg-config")
